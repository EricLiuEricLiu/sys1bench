{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "sys1bench",
  "main": "server/index.js",
  "compatibility_date": "2026-10-28",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sys1bench",
      "migrations_dir": "migrations"
    }
  ],
  "routes": [{ "pattern": "sys1bench.com", "custom_domain": true }]
}
